<!-- ═══════════════════════════════════════════════════════════════
     SCRIPTS
══════════════════════════════════════════════════════════════════ -->
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script>
'use strict';

// ── Utility ───────────────────────────────────────────────────
function fmtRs(v) {
    v = parseFloat(v)||0;
    if (v>=100000) return 'Rs.'+(v/100000).toFixed(1)+'L';
    if (v>=1000)   return 'Rs.'+(v/1000).toFixed(1)+'K';
    return 'Rs.'+v.toFixed(0);
}
function copyToClipboard(txt) {
    if (navigator.clipboard) navigator.clipboard.writeText(txt);
    // Brief visual feedback
    const t = event.currentTarget;
    const orig = t.innerHTML;
    t.innerHTML = '<i class="bi bi-check-lg me-1" style="color:#28c76f;"></i>Copied!';
    setTimeout(()=>t.innerHTML=orig, 1500);
}

// ── Tab Switching ─────────────────────────────────────────────
function aiTab(name, btn) {
    document.querySelectorAll('.ai-section').forEach(s => s.classList.remove('active'));
    document.querySelectorAll('.ai-tab').forEach(b => b.classList.remove('active'));
    document.getElementById('sec-'+name).classList.add('active');
    btn.classList.add('active');
}

// ═══════════════════════════════════════════════════════════════
//  TAB 1 — AI PRODUCT TEST
// ═══════════════════════════════════════════════════════════════
const ptSel = document.getElementById('ptProductSelect');
const ptBtn = document.getElementById('ptRunBtn');
let ptGaugeInst = null, ptForecastInst = null, ptHistoryInst = null;

ptSel && ptSel.addEventListener('change', function(){
    ptBtn.disabled = !this.value;
    if (!this.value) {
        document.getElementById('ptResult').style.display = 'none';
        document.getElementById('ptEmpty').style.display  = '';
        if (ptGaugeInst)    { ptGaugeInst.destroy();    ptGaugeInst = null; }
        if (ptForecastInst) { ptForecastInst.destroy(); ptForecastInst = null; }
        if (ptHistoryInst)  { ptHistoryInst.destroy();  ptHistoryInst = null; }
    }
});

function runProductTest() {
    const opt = ptSel.options[ptSel.selectedIndex];
    if (!opt.value) return;

    const d = {
        name:        opt.dataset.name,
        retail:      parseFloat(opt.dataset.retail)     || 0,
        cost:        parseFloat(opt.dataset.cost)        || 0,
        stock:       parseInt(opt.dataset.stock)         || 0,
        unit:        opt.dataset.unit  || 'pcs',
        min:         parseInt(opt.dataset.min)           || 5,
        cat:         opt.dataset.cat   || 'General',
        qty30:       parseInt(opt.dataset.qty30)         || 0,
        profit30:    parseFloat(opt.dataset.profit30)    || 0,
        txn30:       parseInt(opt.dataset.txn30)         || 0,
        rev30:       parseFloat(opt.dataset.rev30)       || 0,
        qty7:        parseInt(opt.dataset.qty7)          || 0,
        profit7:     parseFloat(opt.dataset.profit7)     || 0,
        totalSold:   parseInt(opt.dataset.totalsold)     || 0,
        totalProfit: parseFloat(opt.dataset.totalprofit) || 0,
        daysActive:  parseInt(opt.dataset.daysactive)    || 0,
    };

    // Loading state
    ptBtn.disabled = true;
    ptBtn.innerHTML = '<i class="bi bi-arrow-repeat" style="animation:spin .7s linear infinite;display:inline-block;"></i> AI Analyzing...';
    document.getElementById('ptResult').style.display = 'none';
    document.getElementById('ptEmpty').style.display  = 'none';

    setTimeout(() => {

        // ═══════════════════════════════════════════════
        //  CORE METRICS
        // ═══════════════════════════════════════════════
        const margin     = d.retail > 0 ? ((d.retail - d.cost) / d.retail * 100) : 0;
        const markup     = d.cost   > 0 ? ((d.retail - d.cost) / d.cost   * 100) : 0;
        const profitUnit = d.retail - d.cost;
        const ss         = d.stock <= 0 ? 'danger' : d.stock <= d.min ? 'warning' : 'good';
        const avg30Daily = d.qty30 / 30;
        const avg7Daily  = d.qty7  / 7;
        const stockDays  = avg7Daily > 0 ? Math.round(d.stock / avg7Daily) : (d.stock > 0 ? 999 : 0);
        const velRatio   = avg30Daily > 0 ? (avg7Daily / avg30Daily) : (d.qty7 > 0 ? 2 : 0);

        // ═══════════════════════════════════════════════
        //  NEW PRODUCT DETECTION  (zero sales history)
        //  AI estimates potential based on price & margin
        // ═══════════════════════════════════════════════
        const isNewProduct = (d.qty30 === 0 && d.qty7 === 0 && d.totalSold === 0 && d.daysActive <= 7);

        // For new products: estimate conservative base demand by margin category
        // High margin (≥30%) → assume 5/mo; medium (15-30%) → 8/mo; lower → 3/mo
        const estMonthlyQty   = isNewProduct
            ? (margin >= 30 ? 5 : margin >= 20 ? 8 : margin >= 12 ? 4 : 2)
            : d.qty30;
        const estMonthlyRev   = isNewProduct ? estMonthlyQty * d.retail     : d.rev30;
        const estMonthlyProfit= isNewProduct ? estMonthlyQty * profitUnit   : d.profit30;

        // ═══════════════════════════════════════════════
        //  AI SCORE  (0 – 100)
        // ═══════════════════════════════════════════════
        let score = 0;
        score += margin >= 40 ? 30 : margin >= 30 ? 25 : margin >= 20 ? 18 : margin >= 12 ? 10 : margin >= 5 ? 4 : 0;
        if (isNewProduct) {
            // New product: score mainly on pricing quality + stock readiness
            score += d.stock >= d.min * 2 ? 20 : d.stock > 0 ? 12 : 0;
            score += margin >= 25 ? 15 : margin >= 15 ? 10 : 5;
            score += 10; // bonus for being freshly listed
        } else {
            score += d.qty30 >= 40 ? 25 : d.qty30 >= 20 ? 20 : d.qty30 >= 8 ? 13 : d.qty30 >= 2 ? 7 : d.qty30 >= 1 ? 3 : 0;
            score += ss === 'good' ? 20 : ss === 'warning' ? 10 : 0;
            score += stockDays <= 0 ? 0 : stockDays <= 7 ? 5 : stockDays <= 30 ? 12 : stockDays <= 90 ? 15 : 10;
            score += d.profit30 >= 1000 ? 10 : d.profit30 >= 300 ? 7 : d.profit30 > 0 ? 4 : d.profit30 < 0 ? -5 : 0;
        }
        if (d.cost > d.retail && d.retail > 0) score -= 20;   // penalty: selling below cost
        score = Math.min(100, Math.max(1, Math.round(score)));

        const winPct  = score;
        const losePct = 100 - score;
        const stars   = '★'.repeat(Math.ceil(score / 20)) + '☆'.repeat(5 - Math.ceil(score / 20));

        const grade = score >= 88 ? { g:'A+', c:'#28c76f', l:'Star Product'   } :
                      score >= 72 ? { g:'A',  c:'#3ECFCF', l:'Strong Product'  } :
                      score >= 52 ? { g:'B',  c:'#6C63FF', l:'Good Product'    } :
                      score >= 32 ? { g:'C',  c:'#ff9f43', l:'Average Product' } :
                                    { g:'D',  c:'#ea5455', l:'Weak Product'    };

        // ═══════════════════════════════════════════════
        //  GROWTH FACTOR  (based on velocity trend)
        // ═══════════════════════════════════════════════
        //  isNewProduct     → neutral start (1.0), grows as sales kick in
        //  velRatio >= 1.5  → accelerating  (+15 % / month)
        //  velRatio >= 0.8  → stable        (  0 % / month)
        //  velRatio <  0.5  → declining     ( -18 % / month)
        //  velRatio == 0    → dead stock    ( -25 % / month)
        const gf = isNewProduct ? 1.10 :   // new product: optimistic launch growth
                   velRatio >= 1.5 ? 1.15 :
                   velRatio >= 0.8 ? 1.00 :
                   velRatio >= 0.5 ? 0.92 :
                   d.qty30  > 0    ? 0.82 : 0.75;

        // ═══════════════════════════════════════════════
        //  BASE VALUES  (actual or AI-estimated for new products)
        // ═══════════════════════════════════════════════
        const baseQty    = estMonthlyQty;
        const baseRev    = estMonthlyRev;
        const baseProfit = estMonthlyProfit;

        // ═══════════════════════════════════════════════
        //  3-MONTH MONTHLY FORECAST
        // ═══════════════════════════════════════════════
        const months = ['Next 30 Days (Month 1)', 'Days 31–60 (Month 2)', 'Days 61–90 (Month 3)'];
        const mQty    = [Math.round(baseQty * gf),    Math.round(baseQty * gf * gf),    Math.round(baseQty * gf * gf * gf)];
        const mRev    = [Math.round(baseRev * gf),    Math.round(baseRev * gf * gf),    Math.round(baseRev * gf * gf * gf)];
        const mProfit = [Math.round(baseProfit * gf), Math.round(baseProfit * gf * gf), Math.round(baseProfit * gf * gf * gf)];
        const mMargin = mRev.map((r, i) => r > 0 ? (mProfit[i] / r * 100) : margin);

        // ═══════════════════════════════════════════════
        //  12-WEEK FORECAST  (for chart + table)
        // ═══════════════════════════════════════════════
        const wkQty = baseQty / 4;
        const wkRev = baseRev / 4;
        const wkPro = baseProfit / 4;
        // Compound growth per week = monthly gf ^ (1/4)
        const wkGF  = Math.pow(gf, 0.25);

        const wkLabels  = [];
        const wkQtyArr  = [];
        const wkRevArr  = [];
        const wkProArr  = [];
        for (let w = 1; w <= 12; w++) {
            const factor = Math.pow(wkGF, w);
            wkLabels.push(w <= 4 ? `W${w}` : `W${w} ›`);
            wkQtyArr.push(Math.round(wkQty * factor));
            wkRevArr.push(Math.round(wkRev * factor));
            wkProArr.push(Math.round(wkPro * factor));
        }

        // Break-even units (how many to sell to recover current stock cost)
        const breakEvenUnits = profitUnit > 0 ? Math.ceil((d.stock * d.cost) / profitUnit) : 0;
        const breakEvenDays  = avg30Daily > 0 ? Math.ceil(breakEvenUnits / avg30Daily) : 0;

        // ═══════════════════════════════════════════════
        //  VERDICT  (all English)
        // ═══════════════════════════════════════════════
        //  VERDICT  (all English, new-product aware)
        // ═══════════════════════════════════════════════
        let vBg, vBc, vTc, vIc, vTitle, vText;
        if (isNewProduct) {
            // Special verdict for brand-new products with no sales yet
            if (margin >= 25) {
                [vBg, vBc, vTc, vIc] = ['rgba(62,207,207,.08)', 'rgba(62,207,207,.28)', '#3ECFCF', 'rocket-takeoff-fill'];
                vTitle = `New Product — Strong Potential 🚀 — AI Score ${score}/100`;
                vText  = `<b>${d.name}</b> is a new product with <b>no sales history yet</b>. However, the pricing looks strong — <b>${margin.toFixed(1)}% margin</b> earns you <b>Rs.${profitUnit.toFixed(0)} profit per ${d.unit}</b>. AI estimates it could generate <b>Rs.${fmtRs(mRev[0])}</b> in revenue and <b>${fmtRs(mProfit[0])}</b> profit in Month 1 if marketed well. Feature it prominently on your POS and recommend it to regular customers to kickstart sales.`;
            } else if (margin >= 12) {
                [vBg, vBc, vTc, vIc] = ['rgba(108,99,255,.08)', 'rgba(108,99,255,.24)', '#6C63FF', 'info-circle-fill'];
                vTitle = `New Product — Getting Started ⚡ — AI Score ${score}/100`;
                vText  = `<b>${d.name}</b> is newly added with <b>no sales history yet</b>. The margin is <b>${margin.toFixed(1)}%</b> (Rs.${profitUnit.toFixed(0)}/unit profit). AI forecast is based on estimated market demand for this category. Consider pricing at <b>Rs.${Math.round(d.cost / 0.75 / 5) * 5}</b> to achieve 25% margin and improve future performance.`;
            } else {
                [vBg, vBc, vTc, vIc] = ['rgba(255,159,67,.08)', 'rgba(255,159,67,.24)', '#ff9f43', 'exclamation-circle-fill'];
                vTitle = `New Product — Low Margin Warning ⚠️ — AI Score ${score}/100`;
                vText  = `<b>${d.name}</b> is newly added but the margin is only <b>${margin.toFixed(1)}%</b> — which is below recommended (25%). Before pushing sales, consider raising the price to <b>Rs.${Math.round(d.cost / 0.75 / 5) * 5}</b> to achieve a 25% margin and ensure every unit sold is profitable.`;
            }
        } else if (score >= 75) {
            [vBg, vBc, vTc, vIc] = ['rgba(40,199,111,.09)', 'rgba(40,199,111,.28)', '#28c76f', 'trophy-fill'];
            vTitle = `Star Product 🏆 — AI Score ${score}/100`;
            vText  = d.qty30 > 0
                ? `<b>${d.name}</b> is a top performer! Sold <b>${d.qty30} ${d.unit}</b> in the last 30 days, generating <b>Rs.${Math.round(d.profit30).toLocaleString()}</b> net profit at a <b>${margin.toFixed(1)}%</b> margin. Keep this product well-stocked at all times — it recovers capital fast. Based on current velocity, expect <b>${mQty[0]} ${d.unit}</b> sold and <b>${fmtRs(mProfit[0])}</b> profit next month.`
                : `<b>${d.name}</b> has excellent pricing — <b>${margin.toFixed(1)}% margin</b>, Rs.${profitUnit.toFixed(0)} profit per ${d.unit}. Sales are currently slow — feature it on your POS screen and promote it to regular customers to unlock its potential.`;
        } else if (score >= 50) {
            [vBg, vBc, vTc, vIc] = ['rgba(108,99,255,.08)', 'rgba(108,99,255,.24)', '#6C63FF', 'graph-up-arrow'];
            vTitle = `Good Product ⚡ — AI Score ${score}/100`;
            vText  = d.qty30 > 0
                ? `<b>${d.name}</b> is performing at a good level. Sold <b>${d.qty30} ${d.unit}</b> in 30 days at <b>${margin.toFixed(1)}% margin</b>. A 5% margin improvement would generate an extra <b>Rs.${Math.round(d.qty30 * d.retail * 0.05).toLocaleString()}/month</b>. Review your supplier rate or adjust the selling price slightly.`
                : `<b>${d.name}</b> has a <b>${margin.toFixed(1)}% margin</b> but sales are slow. Change its shelf placement or recommend it to customers at checkout to boost movement.`;
        } else if (score >= 30) {
            [vBg, vBc, vTc, vIc] = ['rgba(255,159,67,.08)', 'rgba(255,159,67,.24)', '#ff9f43', 'exclamation-circle-fill'];
            vTitle = `Weak Product ⚠️ — AI Score ${score}/100`;
            vText  = `<b>${d.name}</b> is underperforming. Margin is only <b>${margin.toFixed(1)}%</b>${d.qty30 < 3 ? ' and sales are negligible' : ''}. Review your pricing strategy, negotiate a better supplier rate, or consider replacing it with a higher-margin alternative.`;
        } else {
            [vBg, vBc, vTc, vIc] = ['rgba(234,84,85,.1)', 'rgba(234,84,85,.35)', '#ea5455', 'radioactive'];
            vTitle = `Critical Risk 🚨 — AI Score ${score}/100`;
            vText  = d.cost > d.retail
                ? `<b>${d.name}</b> is being sold BELOW COST! Every sale generates a loss of <b>Rs.${Math.abs(Math.round(profitUnit))}</b>. Fix the price immediately — minimum recommended price: <b>Rs.${Math.round(d.cost / 0.85 / 5) * 5}</b> (15% margin).`
                : d.qty30 === 0 && d.stock > 0
                ? `<b>${d.name}</b> has <b>${d.stock} ${d.unit}</b> in stock but <b>ZERO sales in 30 days</b>. This is becoming dead stock with <b>Rs.${Math.round(d.stock * d.cost).toLocaleString()}</b> capital locked. Apply a 15–20% discount or bundle it with a fast-moving product to clear it.`
                : `<b>${d.name}</b> is critically underperforming. Immediate corrective action is required — review price, margin, supplier, or consider discontinuing.`;
        }

        // ═══════════════════════════════════════════════
        //  ACTIONABLE SUGGESTIONS  (all English)
        // ═══════════════════════════════════════════════
        const suggs = [];

        // — Pricing —
        if (d.cost > d.retail && d.retail > 0)
            suggs.push({ ic:'exclamation-octagon-fill', cl:'#ea5455',
                tx:`<b>Selling Below Cost!</b> You lose Rs.${Math.abs(Math.round(profitUnit))} on every sale. Set the minimum price to <b>Rs.${Math.round(d.cost / 0.85 / 5) * 5}</b> to achieve a 15% margin. Current cost price: Rs.${d.cost}.` });
        else if (margin < 12)
            suggs.push({ ic:'arrow-up-circle-fill', cl:'#ea5455',
                tx:`<b>Margin is critically low at ${margin.toFixed(1)}%.</b> Recommended selling price: <b>Rs.${Math.round(d.cost / 0.80 / 5) * 5}</b> (targets 20% margin). Alternatively, negotiate a lower cost price from your supplier.` });
        else if (margin >= 35)
            suggs.push({ ic:'star-fill', cl:'#28c76f',
                tx:`<b>Excellent ${margin.toFixed(1)}% margin!</b> Create a bundle deal (buy 2 + get 5% off) — this increases volume while maintaining strong profit per unit. You earn Rs.${profitUnit.toFixed(0)} per ${d.unit}.` });
        else
            suggs.push({ ic:'arrow-up-circle', cl:'#ff9f43',
                tx:`<b>Margin is ${margin.toFixed(1)}% — there is room to improve.</b> Try raising the price to <b>Rs.${Math.round(d.cost / 0.75 / 5) * 5}</b> to hit a 25% margin target. Test customer sensitivity before making it permanent.` });

        // — Stock —
        if (d.stock <= 0)
            suggs.push({ ic:'box-seam', cl:'#ea5455',
                tx:`<b>Out of Stock!</b> Reorder immediately — minimum <b>${Math.max(20, d.min * 5)} ${d.unit}</b> recommended. You are losing approximately <b>Rs.${Math.round(avg30Daily * profitUnit).toLocaleString()}/day</b> in missed profit at your current sales rate.` });
        else if (stockDays < 7 && d.qty30 > 0)
            suggs.push({ ic:'exclamation-triangle-fill', cl:'#ff9f43',
                tx:`<b>Only ${stockDays} days of stock remaining</b> at your current sales pace. Place a reorder today for at least <b>${Math.max(d.min * 4, d.qty30)} ${d.unit}</b> to avoid a stockout.` });
        else if (stockDays > 90 && d.qty30 === 0)
            suggs.push({ ic:'archive', cl:'#ff9f43',
                tx:`<b>${d.stock} ${d.unit} sitting idle for 90+ days with zero sales.</b> Apply a 15–20% discount or bundle with a fast-seller to clear this stock. Capital locked: <b>Rs.${Math.round(d.stock * d.cost).toLocaleString()}</b>.` });
        else if (breakEvenUnits > 0 && d.qty30 > 0)
            suggs.push({ ic:'calculator', cl:'#3ECFCF',
                tx:`<b>Break-even point:</b> Sell <b>${breakEvenUnits} ${d.unit}</b> to fully recover the cost of your current stock. At your current sales rate, that takes approximately <b>${breakEvenDays} days</b>.` });

        // — Velocity / trend —
        if (d.qty30 === 0 && d.stock > 0)
            suggs.push({ ic:'megaphone-fill', cl:'#6C63FF',
                tx:`<b>Zero sales in 30 days.</b> Place it in the "Featured" section on your POS screen. Personally recommend it to regular customers at checkout. Promote it on your WhatsApp Business status for quick visibility.` });
        else if (velRatio >= 1.5 && d.qty30 > 0)
            suggs.push({ ic:'rocket-takeoff-fill', cl:'#28c76f',
                tx:`<b>Sales are accelerating fast!</b> Your 7-day rate is <b>${velRatio.toFixed(1)}× your 30-day average</b>. Ensure sufficient stock and add a quantity discount — capitalize on this momentum before it slows.` });
        else if (d.txn30 >= 5)
            suggs.push({ ic:'people-fill', cl:'#3ECFCF',
                tx:`<b>${d.txn30} transactions in 30 days</b> — you have a consistent customer base for this product. Introduce a loyalty reward: "Buy 3, get 10% off" to increase the average transaction value.` });

        // — Future outlook —
        const futureProfit3m = mProfit[0] + mProfit[1] + mProfit[2];
        const futureQty3m    = mQty[0] + mQty[1] + mQty[2];
        if (futureProfit3m > 0)
            suggs.push({ ic:'graph-up-arrow', cl:'#3ECFCF',
                tx:`<b>3-Month Profit Outlook: ${fmtRs(futureProfit3m)}</b> projected over the next 90 days on <b>${futureQty3m} ${d.unit}</b> sold. To maximise this: maintain stock above <b>${Math.max(d.min, Math.round(mQty[0] * 1.2))} ${d.unit}</b> per month and keep the price stable.` });
        else if (futureProfit3m < 0)
            suggs.push({ ic:'exclamation-octagon-fill', cl:'#ea5455',
                tx:`<b>Warning: 3-Month Loss Forecast of ${fmtRs(Math.abs(futureProfit3m))}</b>. The current trend suggests continued losses. Consider: raising the selling price to Rs.${Math.round(d.cost/0.8/5)*5} (20% margin), reducing cost via supplier negotiation, or discontinuing this product.` });
        else if (suggs.length < 3)
            suggs.push({ ic:'check-circle-fill', cl:'#28c76f',
                tx:`<b>Score ${score}/100 — keep improving!</b> Consider bulk purchasing to reduce your cost price by 5–10% on volume orders — this directly improves your margin without changing the retail price.` });

        // — Stock adequacy for forecast —
        const stockNeededForSugg = Math.max(0, mQty[0] - d.stock);
        if (stockNeededForSugg > 0 && d.stock >= 0)
            suggs.push({ ic:'box-seam', cl:'#ff9f43',
                tx:`<b>Stock shortfall detected!</b> You currently have <b>${d.stock} ${d.unit}</b> but are projected to sell <b>${mQty[0]} ${d.unit}</b> next month. Order at least <b>${stockNeededForSugg + Math.round(mQty[0]*0.15)} ${d.unit}</b> extra (includes 15% safety buffer) to avoid a stockout.` });

        // ═══════════════════════════════════════════════
        //  RENDER — Daily Stats Row  (NEW)
        // ═══════════════════════════════════════════════
        const dailyQty    = (avg7Daily > 0 ? avg7Daily : avg30Daily);
        const dailyRev    = dailyQty * d.retail;
        const dailyProfit = dailyQty * profitUnit;
        const dailyColor  = dailyProfit > 0 ? '#28c76f' : dailyProfit < 0 ? '#ea5455' : '#ff9f43';
        document.getElementById('ptDailyStats').innerHTML = [
            { l:'Daily Sales Rate',   v: dailyQty.toFixed(1)+' '+d.unit,  s:'Based on last 7d',        c:'#3ECFCF'    },
            { l:'Daily Revenue Est.', v: fmtRs(dailyRev),                 s:'At Rs.'+d.retail+'/unit', c:'#6C63FF'    },
            { l:'Daily Profit Est.',  v: fmtRs(dailyProfit),              s:'At Rs.'+profitUnit.toFixed(0)+' margin', c: dailyColor },
            { l:'Stock Will Last',    v: stockDays<999 ? stockDays+' days' : '∞ Sufficient', s: stockDays<7?'⚠️ Reorder soon':stockDays<30?'Monitor closely':'Healthy stock', c: ss==='good'?'#28c76f':ss==='warning'?'#ff9f43':'#ea5455' },
        ].map(m => `<div class="col-6 col-md-3"><div class="summary-stat" style="border-color:${m.c}33;"><div class="s-num" style="color:${m.c};font-size:1.05rem;">${m.v}</div><div class="s-lbl">${m.l}</div><div style="font-size:.62rem;color:rgba(255,255,255,.28);margin-top:2px;">${m.s}</div></div></div>`).join('');

        // ═══════════════════════════════════════════════
        //  RENDER — 7-Day Forecast Cards  (NEW)
        // ═══════════════════════════════════════════════
        const day7GF    = Math.pow(gf, 7/30);   // growth factor for 7 days
        const day7Qty   = Math.round(dailyQty * 7 * day7GF);
        const day7Rev   = Math.round(day7Qty * d.retail);
        const day7Pro   = Math.round(day7Qty * profitUnit);
        const day7Mgn   = day7Rev > 0 ? (day7Pro / day7Rev * 100) : margin;
        const day7PColor= day7Pro >= 0 ? '#28c76f' : '#ea5455';
        const day7Trend = day7GF > 1.03 ? '📈 Rising demand' : day7GF < 0.97 ? '📉 Falling demand' : '➡️ Steady demand';
        document.getElementById('pt7DayCards').innerHTML = [
            { l:'Pieces to Sell',  v: day7Qty+' '+d.unit,  s:'Projected units',     c:'#ff9f43'  },
            { l:'Expected Revenue',v: fmtRs(day7Rev),       s:'Gross sales',         c:'#6C63FF'  },
            { l:'Expected Profit', v: fmtRs(day7Pro),       s: day7Pro>=0?'Net profit':'Net loss', c: day7PColor },
            { l:'Avg Margin',      v: day7Mgn.toFixed(1)+'%', s:'7-day projected',   c: day7Mgn>=25?'#28c76f':day7Mgn>=12?'#ff9f43':'#ea5455' },
        ].map(m => `<div class="col-6 col-md-3"><div style="background:rgba(0,0,0,.22);border:1px solid ${m.c}33;border-radius:12px;padding:.75rem .9rem;"><div style="font-size:.62rem;color:rgba(255,255,255,.32);margin-bottom:3px;">${m.l}</div><div style="font-size:1.1rem;font-weight:900;color:${m.c};">${m.v}</div><div style="font-size:.62rem;color:rgba(255,255,255,.22);margin-top:2px;">${m.s}</div></div></div>`).join('') +
            `<div class="col-12 mt-1"><div style="font-size:.72rem;color:rgba(255,255,255,.32);padding:.3rem .4rem;">${day7Trend} · <b style="color:#3ECFCF;">${velRatio.toFixed(2)}× velocity</b> vs 30-day average · Daily rate: <b>${dailyQty.toFixed(1)} ${d.unit}/day</b></div></div>`;


        document.getElementById('ptProdName').textContent = d.name;
        document.getElementById('ptProdMeta').textContent =
            `${d.cat}  ·  Rs.${d.retail.toFixed(0)} selling price  ·  Rs.${d.cost.toFixed(0)} cost  ·  ${d.stock} ${d.unit} in stock`;
        document.getElementById('ptScoreBadge').innerHTML =
            `<span style="color:${grade.c};">${score}<span style="font-size:.65rem;">/100</span></span>`;
        document.getElementById('ptGrade').innerHTML =
            `<span style="color:${grade.c};">${grade.g}</span> <span style="color:rgba(255,255,255,.4);">— ${grade.l}</span>`;
        document.getElementById('ptStars').textContent = stars;

        // ═══════════════════════════════════════════════
        //  RENDER — Metric Tiles (current performance)
        // ═══════════════════════════════════════════════
        document.getElementById('ptMetrics').innerHTML = [
            { l:'Profit Margin',  v: margin.toFixed(1) + '%',          s:'Per sale',                   c: margin >= 25 ? '#28c76f' : margin >= 12 ? '#ff9f43' : '#ea5455' },
            { l:'Profit / Unit',  v: 'Rs.' + profitUnit.toFixed(0),    s:'Per ' + d.unit,              c: profitUnit > 0 ? '#28c76f' : '#ea5455' },
            { l:'Sold (30d)',      v: d.qty30 + ' ' + d.unit,          s: d.txn30 + ' transactions',   c: d.qty30 >= 10 ? '#28c76f' : d.qty30 >= 3 ? '#ff9f43' : '#ea5455' },
            { l:'Stock Remaining',v: d.stock + ' ' + d.unit,           s: stockDays < 999 ? stockDays + 'd at current rate' : 'Sufficient', c: ss === 'good' ? '#28c76f' : ss === 'warning' ? '#ff9f43' : '#ea5455' },
            { l:'30d Revenue',    v: fmtRs(d.rev30),                   s:'Gross revenue',              c: d.rev30 >= 5000 ? '#28c76f' : d.rev30 >= 500 ? '#ff9f43' : '#ea5455' },
            { l:'30d Net Profit', v: fmtRs(d.profit30),                s:'After cost',                 c: d.profit30 > 0 ? '#28c76f' : '#ea5455' },
        ].map(m => `<div class="ai-metric-tile"><div class="lbl">${m.l}</div><div class="val" style="color:${m.c};">${m.v}</div><div class="sub">${m.s}</div></div>`).join('');

        // ═══════════════════════════════════════════════
        //  RENDER — Win/Loss Gauge (doughnut)
        // ═══════════════════════════════════════════════
        if (ptGaugeInst) ptGaugeInst.destroy();
        const gc = winPct >= 65 ? '#28c76f' : winPct >= 45 ? '#ff9f43' : '#ea5455';
        ptGaugeInst = new Chart(document.getElementById('ptGaugeChart'), {
            type: 'doughnut',
            data: {
                labels: ['Win Chance', 'Risk'],
                datasets: [{ data: [winPct, losePct], backgroundColor: [gc, 'rgba(255,255,255,.05)'], borderWidth: 0, hoverOffset: 4 }]
            },
            options: {
                responsive: false, cutout: '74%',
                plugins: { legend: { display: false }, tooltip: { callbacks: { label: c => c.label + ': ' + c.raw + '%' } } },
                animation: { animateRotate: true, duration: 900 }
            }
        });
        document.getElementById('ptGaugeLabel').innerHTML =
            `<span style="color:${gc};font-weight:800;">${winPct}% Win Chance</span><br><span style="color:rgba(255,255,255,.35);font-size:.7rem;">${losePct}% Risk</span>`;
        document.getElementById('ptBreakEven').textContent =
            breakEvenUnits > 0 ? `Break-even: sell ${breakEvenUnits} ${d.unit} (~${breakEvenDays} days)` : '';

        // ═══════════════════════════════════════════════
        //  RENDER — Last-30d History Chart
        // ═══════════════════════════════════════════════
        if (ptHistoryInst) ptHistoryInst.destroy();
        const hWks = ['Week 1', 'Week 2', 'Week 3', 'Week 4'];
        const hRev = [Math.round(d.rev30/4), Math.round(d.rev30/4), Math.round(d.rev30/4), Math.round(d.rev30/4)];
        const hPro = [Math.round(d.profit30/4), Math.round(d.profit30/4), Math.round(d.profit30/4), Math.round(d.profit30/4)];
        ptHistoryInst = new Chart(document.getElementById('ptHistoryChart'), {
            type: 'bar',
            data: {
                labels: hWks,
                datasets: [
                    { label: 'Revenue', data: hRev, backgroundColor: 'rgba(108,99,255,.5)', borderColor: '#6C63FF', borderWidth: 1.5, borderRadius: 6, order: 2 },
                    { label: 'Profit',  data: hPro, type: 'line', borderColor: '#28c76f', backgroundColor: 'rgba(40,199,111,.1)', borderWidth: 2, pointBackgroundColor: '#28c76f', pointRadius: 4, fill: true, tension: .4, order: 1 }
                ]
            },
            options: {
                responsive: true, interaction: { mode: 'index', intersect: false },
                plugins: { legend: { display: true, position: 'top', labels: { color: 'rgba(255,255,255,.45)', boxWidth: 10, font: { size: 10 } } }, tooltip: { callbacks: { label: c => ' ' + fmtRs(c.parsed.y) } } },
                scales: {
                    y: { beginAtZero: true, grid: { color: 'rgba(255,255,255,.05)' }, ticks: { color: 'rgba(255,255,255,.4)', callback: v => fmtRs(v) } },
                    x: { grid: { display: false }, ticks: { color: 'rgba(255,255,255,.4)', font: { size: 10 } } }
                },
                animation: { duration: 700 }
            }
        });

        // ═══════════════════════════════════════════════
        //  RENDER — 3-Month Forecast Cards
        // ═══════════════════════════════════════════════
        const mColors  = ['#6C63FF', '#3ECFCF', '#28c76f'];
        const mBorders = ['rgba(108,99,255,.25)', 'rgba(62,207,207,.25)', 'rgba(40,199,111,.25)'];
        document.getElementById('ptMonthCards').innerHTML = [0, 1, 2].map(i => {
            const pColor = mProfit[i] >= 0 ? '#28c76f' : '#ea5455';
            const mColor = mMargin[i] >= 25 ? '#28c76f' : mMargin[i] >= 12 ? '#ff9f43' : '#ea5455';
            return `
            <div class="col-12 col-md-4">
              <div style="background:rgba(0,0,0,.25);border:1px solid ${mBorders[i]};border-radius:14px;padding:1rem 1.1rem;">
                <div style="color:${mColors[i]};font-size:.72rem;font-weight:800;text-transform:uppercase;letter-spacing:.8px;margin-bottom:.7rem;">
                  <i class="bi bi-calendar3 me-1"></i>${months[i]}
                </div>
                <div class="row g-2">
                  <div class="col-6">
                    <div style="font-size:.62rem;color:rgba(255,255,255,.3);margin-bottom:2px;">Units Sold</div>
                    <div style="font-size:1.25rem;font-weight:900;color:${mColors[i]};">${mQty[i]}</div>
                    <div style="font-size:.62rem;color:rgba(255,255,255,.22);">${d.unit}</div>
                  </div>
                  <div class="col-6">
                    <div style="font-size:.62rem;color:rgba(255,255,255,.3);margin-bottom:2px;">Revenue</div>
                    <div style="font-size:1.1rem;font-weight:900;color:#fff;">${fmtRs(mRev[i])}</div>
                    <div style="font-size:.62rem;color:rgba(255,255,255,.22);">gross</div>
                  </div>
                  <div class="col-6">
                    <div style="font-size:.62rem;color:rgba(255,255,255,.3);margin-bottom:2px;">Net Profit</div>
                    <div style="font-size:1.1rem;font-weight:900;color:${pColor};">${fmtRs(mProfit[i])}</div>
                    <div style="font-size:.62rem;color:rgba(255,255,255,.22);">${mProfit[i] >= 0 ? 'profit' : 'LOSS'}</div>
                  </div>
                  <div class="col-6">
                    <div style="font-size:.62rem;color:rgba(255,255,255,.3);margin-bottom:2px;">Margin</div>
                    <div style="font-size:1.1rem;font-weight:900;color:${mColor};">${mMargin[i].toFixed(1)}%</div>
                    <div style="font-size:.62rem;color:rgba(255,255,255,.22);">projected</div>
                  </div>
                </div>
              </div>
            </div>`;
        }).join('');

        // Forecast trend label
        const totalProj3m = mProfit[0] + mProfit[1] + mProfit[2];
        const trendLabel  = gf > 1 ? `📈 Growing +${((gf-1)*100).toFixed(0)}%/mo` : gf < 1 ? `📉 Declining ${(((1-gf)*100).toFixed(0))}%/mo` : `➡️ Stable trend`;
        document.getElementById('ptForecastTrend').innerHTML =
            `<span style="color:${gf>=1?'#28c76f':'#ea5455'};">${trendLabel}</span>
             <span style="color:rgba(255,255,255,.28);margin-left:.6rem;font-size:.7rem;">90d total: ${fmtRs(totalProj3m)}</span>`;

        // ═══════════════════════════════════════════════
        //  RENDER — 12-Week Forecast Chart
        // ═══════════════════════════════════════════════
        if (ptForecastInst) ptForecastInst.destroy();
        ptForecastInst = new Chart(document.getElementById('ptForecastChart'), {
            type: 'bar',
            data: {
                labels: wkLabels,
                datasets: [
                    {
                        label: 'Revenue (Rs.)',
                        data: wkRevArr,
                        backgroundColor: wkLabels.map((_, i) => i < 4 ? 'rgba(108,99,255,.55)' : i < 8 ? 'rgba(62,207,207,.35)' : 'rgba(40,199,111,.25)'),
                        borderColor:     wkLabels.map((_, i) => i < 4 ? '#6C63FF' : i < 8 ? '#3ECFCF' : '#28c76f'),
                        borderWidth: 1.5, borderRadius: 5, order: 2
                    },
                    {
                        label: 'Profit (Rs.)',
                        type: 'line',
                        data: wkProArr,
                        borderColor: '#28c76f',
                        backgroundColor: 'rgba(40,199,111,.08)',
                        borderWidth: 2.5,
                        pointBackgroundColor: wkProArr.map(v => v >= 0 ? '#28c76f' : '#ea5455'),
                        pointRadius: 4,
                        fill: true, tension: .38, order: 1,
                        segment: { borderDash: ctx => ctx.p0DataIndex >= 3 ? [5, 4] : undefined }
                    },
                    {
                        label: 'Units Sold',
                        type: 'line',
                        data: wkQtyArr,
                        borderColor: '#ff9f43',
                        backgroundColor: 'transparent',
                        borderWidth: 1.8,
                        pointBackgroundColor: '#ff9f43',
                        pointRadius: 3,
                        fill: false, tension: .38, order: 0,
                        yAxisID: 'y2',
                        segment: { borderDash: ctx => ctx.p0DataIndex >= 3 ? [4, 3] : undefined }
                    }
                ]
            },
            options: {
                responsive: true,
                interaction: { mode: 'index', intersect: false },
                plugins: {
                    legend: { display: true, position: 'top', labels: { color: 'rgba(255,255,255,.45)', boxWidth: 10, font: { size: 10 } } },
                    tooltip: {
                        callbacks: {
                            label: c => {
                                if (c.dataset.yAxisID === 'y2') return ` Units: ${c.parsed.y}`;
                                return ' ' + fmtRs(c.parsed.y);
                            }
                        }
                    }
                },
                scales: {
                    y:  { beginAtZero: true, position: 'left',  grid: { color: 'rgba(255,255,255,.05)' }, ticks: { color: 'rgba(255,255,255,.4)', callback: v => fmtRs(v) } },
                    y2: { beginAtZero: true, position: 'right', grid: { display: false },                 ticks: { color: '#ff9f43', font: { size: 9 } }, title: { display: true, text: 'Units', color: '#ff9f43', font: { size: 9 } } },
                    x:  { grid: { display: false }, ticks: { color: 'rgba(255,255,255,.4)', font: { size: 9 } } }
                },
                animation: { duration: 900 }
            }
        });

        // ═══════════════════════════════════════════════
        //  RENDER — 12-Week Table  (enhanced with profit/unit)
        // ═══════════════════════════════════════════════
        const signals = ['Historical', 'Historical', 'Historical', 'Historical'];
        for (let w = 4; w < 12; w++) {
            const wRatio = wkQtyArr[w] / Math.max(1, wkQtyArr[3]);
            signals.push(wRatio > 1.08 ? '🟢 Growing' : wRatio < 0.92 ? '🔴 Declining' : '🟡 Stable');
        }
        document.getElementById('ptWeekTableBody').innerHTML = wkLabels.map((lbl, i) => {
            const pColor   = wkProArr[i] >= 0 ? '#28c76f' : '#ea5455';
            const mPct     = wkRevArr[i] > 0 ? (wkProArr[i] / wkRevArr[i] * 100).toFixed(1) : '0.0';
            const profitPU = wkQtyArr[i] > 0 ? (wkProArr[i] / wkQtyArr[i]).toFixed(0) : profitUnit.toFixed(0);
            const rowBg    = i < 4 ? '' : i < 8 ? 'background:rgba(62,207,207,.04);' : 'background:rgba(40,199,111,.04);';
            const lbl2     = i < 4 ? `<span style="font-size:.62rem;color:rgba(255,255,255,.3);margin-left:4px;">(hist)</span>` : '';
            return `<tr style="border-bottom:1px solid rgba(255,255,255,.04);${rowBg}">
                <td style="padding:.38rem .6rem;color:${i<4?'rgba(255,255,255,.45)':'#fff'};font-weight:${i<4?'400':'600'};">${lbl}${lbl2}</td>
                <td style="padding:.38rem .6rem;text-align:right;color:#ff9f43;font-weight:700;">${wkQtyArr[i]} <span style="font-size:.62rem;color:rgba(255,255,255,.25);">${d.unit}</span></td>
                <td style="padding:.38rem .6rem;text-align:right;color:#6C63FF;font-weight:700;">${fmtRs(wkRevArr[i])}</td>
                <td style="padding:.38rem .6rem;text-align:right;color:${pColor};font-weight:700;">${fmtRs(wkProArr[i])}</td>
                <td style="padding:.38rem .6rem;text-align:right;color:rgba(255,255,255,.4);">${mPct}%</td>
                <td style="padding:.38rem .6rem;text-align:right;color:rgba(255,255,255,.35);">Rs.${profitPU}</td>
                <td style="padding:.38rem .6rem;font-size:.7rem;color:rgba(255,255,255,.35);">${signals[i]}</td>
            </tr>`;
        }).join('');

        // ═══════════════════════════════════════════════
        //  RENDER — Cumulative 90-Day Totals  (NEW)
        // ═══════════════════════════════════════════════
        const cum90Qty    = mQty[0]    + mQty[1]    + mQty[2];
        const cum90Rev    = mRev[0]    + mRev[1]    + mRev[2];
        const cum90Pro    = mProfit[0] + mProfit[1] + mProfit[2];
        const cum90Margin = cum90Rev > 0 ? (cum90Pro / cum90Rev * 100) : margin;
        const cum90PColor = cum90Pro >= 0 ? '#28c76f' : '#ea5455';
        document.getElementById('ptCumulativeCards').innerHTML = [
            { l:'Total Pieces Sold',  v: cum90Qty+' '+d.unit,      s:'Over 90 days',                 c:'#ff9f43'    },
            { l:'Total Revenue',      v: fmtRs(cum90Rev),           s:'Gross 3-month sales',          c:'#6C63FF'    },
            { l:'Total Net Profit',   v: fmtRs(cum90Pro),           s: cum90Pro>=0?'3-month profit':'3-month LOSS', c: cum90PColor },
            { l:'Avg Margin',         v: cum90Margin.toFixed(1)+'%', s:'Projected average',           c: cum90Margin>=25?'#28c76f':cum90Margin>=12?'#ff9f43':'#ea5455' },
        ].map(m => `<div class="col-6 col-md-3"><div class="summary-stat" style="border-color:${m.c}33;"><div class="s-num" style="color:${m.c};font-size:1.05rem;">${m.v}</div><div class="s-lbl">${m.l}</div><div style="font-size:.62rem;color:rgba(255,255,255,.28);margin-top:2px;">${m.s}</div></div></div>`).join('');

        // ═══════════════════════════════════════════════
        //  RENDER — Projected Next-Month Summary Row  (enhanced)
        // ═══════════════════════════════════════════════
        const pm = mMargin[0];
        const pmColor = pm >= 25 ? '#28c76f' : pm >= 12 ? '#ff9f43' : '#ea5455';
        const profitPerUnitNext = mQty[0] > 0 ? (mProfit[0] / mQty[0]) : profitUnit;
        const stockNeeded = Math.max(0, mQty[0] - d.stock);
        document.getElementById('ptProjectedRow').innerHTML = `
            <div class="col-6 col-md-3">
              <div class="summary-stat" style="border-color:rgba(255,159,67,.25);">
                <div class="s-num" style="color:#ff9f43;font-size:1.2rem;">${mQty[0]} <span style="font-size:.75rem;font-weight:400;">${d.unit}</span></div>
                <div class="s-lbl">📦 Next-Month Units</div>
                <div style="font-size:.62rem;color:rgba(255,255,255,.28);margin-top:3px;">~${(mQty[0]/30).toFixed(1)}/day average</div>
              </div>
            </div>
            <div class="col-6 col-md-3">
              <div class="summary-stat" style="border-color:rgba(108,99,255,.25);">
                <div class="s-num" style="color:#6C63FF;font-size:1.2rem;">${fmtRs(mRev[0])}</div>
                <div class="s-lbl">📈 Next-Month Revenue</div>
                <div style="font-size:.62rem;color:rgba(255,255,255,.28);margin-top:3px;">${fmtRs(mRev[0]/4)}/week avg</div>
              </div>
            </div>
            <div class="col-6 col-md-3">
              <div class="summary-stat" style="border-color:${mProfit[0]>=0?'rgba(40,199,111,.25)':'rgba(234,84,85,.25)'};">
                <div class="s-num" style="color:${mProfit[0]>=0?'#28c76f':'#ea5455'};font-size:1.2rem;">${fmtRs(mProfit[0])}</div>
                <div class="s-lbl">${mProfit[0]>=0?'💰 Next-Month Profit':'❌ Next-Month Loss'}</div>
                <div style="font-size:.62rem;color:rgba(255,255,255,.28);margin-top:3px;">Rs.${profitPerUnitNext.toFixed(0)} per ${d.unit}</div>
              </div>
            </div>
            <div class="col-6 col-md-3">
              <div class="summary-stat" style="border-color:rgba(62,207,207,.25);">
                <div class="s-num" style="color:${pmColor};font-size:1.2rem;">${pm.toFixed(1)}%</div>
                <div class="s-lbl">📊 Projected Margin</div>
                <div style="font-size:.62rem;color:${stockNeeded>0?'#ff9f43':'rgba(255,255,255,.28)'};margin-top:3px;">${stockNeeded>0?'Need '+stockNeeded+' '+d.unit+' more stock':'Stock sufficient'}</div>
              </div>
            </div>`;

        // ═══════════════════════════════════════════════
        //  RENDER — Verdict
        // ═══════════════════════════════════════════════
        const vEl = document.getElementById('ptVerdict');
        vEl.style.cssText = `background:${vBg};border:1px solid ${vBc};border-radius:14px;padding:1.15rem 1.2rem;`;
        vEl.innerHTML = `
            <div class="d-flex align-items-center gap-2 flex-wrap mb-2">
                <i class="bi bi-${vIc}" style="color:${vTc};font-size:1.1rem;"></i>
                <span style="color:${vTc};font-weight:800;font-size:.95rem;">${vTitle}</span>
            </div>
            <p style="color:rgba(255,255,255,.68);font-size:.83rem;margin:0;line-height:1.7;">${vText}</p>`;

        // ═══════════════════════════════════════════════
        //  RENDER — AI Suggestions
        // ═══════════════════════════════════════════════
        document.getElementById('ptSuggestions').innerHTML = suggs.map(s => `
            <div class="pt-sugg">
                <div class="pt-sugg-icon" style="background:${s.cl}1a;">
                    <i class="bi bi-${s.ic}" style="color:${s.cl};font-size:.76rem;"></i>
                </div>
                <span style="font-size:.81rem;color:rgba(255,255,255,.65);line-height:1.65;">${s.tx}</span>
            </div>`).join('');

        // ═══════════════════════════════════════════════
        //  SHOW RESULT
        // ═══════════════════════════════════════════════
        document.getElementById('ptResult').style.display = '';
        document.getElementById('ptEmpty').style.display  = 'none';
        ptBtn.disabled = false;
        ptBtn.innerHTML = '<i class="bi bi-cpu-fill"></i> Test Again';
        document.getElementById('ptResult').scrollIntoView({ behavior: 'smooth', block: 'start' });

    }, 800);
}


// ═══════════════════════════════════════════════════════════════
//  TAB 2 — PRICE OPTIMIZER FILTER
// ═══════════════════════════════════════════════════════════════
function filterPriceRecs(action, btn) {
    document.querySelectorAll('.price-filter-btn').forEach(b => {
        b.style.background = b.dataset.orig || b.style.background;
        b.classList.remove('active');
    });
    btn.classList.add('active');
    document.querySelectorAll('#priceRecList .price-row').forEach(row => {
        row.style.display = (action==='all' || row.dataset.action===action) ? '' : 'none';
    });
}


// ═══════════════════════════════════════════════════════════════
//  TAB 3 — DEMAND FILTER
// ═══════════════════════════════════════════════════════════════
function filterDemand(forecast, btn) {
    document.querySelectorAll('.demand-filter-btn').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    document.querySelectorAll('#demandList .demand-row').forEach(row => {
        row.style.display = (forecast==='all' || row.dataset.forecast===forecast) ? '' : 'none';
    });
}


// ═══════════════════════════════════════════════════════════════
//  TAB 5 — AI BUSINESS ADVISOR
// ═══════════════════════════════════════════════════════════════
const advisorData = {
    rev30:    <?= (float)$shopStats['rev30'] ?>,
    prof30:   <?= (float)$shopStats['prof30'] ?>,
    exp30:    <?= (float)$shopStats['exp30'] ?>,
    margin30: <?= (float)$shopStats['margin30'] ?>,
    txn30:    <?= (int)$shopStats['txn30'] ?>,
    products: <?= json_encode(array_values(array_map(fn($p) => [
        'name'     => str_replace('`', "'", $p['name']),
        'qty30'    => (int)$p['qty_30d'],
        'profit30' => round((float)$p['profit_30d'], 0),
        'margin'   => $p['retail_price']>0 ? round(($p['retail_price']-$p['company_price'])/$p['retail_price']*100,1) : 0,
        'stock'    => (int)$p['stock_quantity'],
        'cost'     => (float)$p['company_price'],
        'retail'   => (float)$p['retail_price'],
        'qty7'     => (int)$p['qty_7d'],
        'rev30'    => round((float)$p['rev_30d'], 0),
    ], $allProducts))) ?>
};

let chatCount = 0;

function askAdvisor(q) {
    q = (q||'').trim();
    if (!q) return;
    document.getElementById('advisorInput').value = '';
    chatCount++;

    const history = document.getElementById('advisorHistory');
    const entryId = 'chat-'+chatCount;

    // User bubble
    const userBubble = document.createElement('div');
    userBubble.className = 'mb-3';
    userBubble.innerHTML = `
        <div style="text-align:right;margin-bottom:.4rem;">
            <span class="advisor-q-bubble">${q}</span>
        </div>
        <div id="${entryId}" class="advisor-bubble">
            <div class="advisor-typing"><span></span><span></span><span></span></div>
        </div>`;
    history.appendChild(userBubble);
    userBubble.scrollIntoView({behavior:'smooth', block:'end'});

    setTimeout(() => {
        const response = generateAdvisorResponse(q.toLowerCase(), advisorData);
        document.getElementById(entryId).innerHTML = `
            <div class="d-flex align-items-center gap-2 mb-2">
                <div style="width:26px;height:26px;border-radius:8px;
                            background:linear-gradient(135deg,#a55eea,#7950d1);
                            display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                    <i class="bi bi-robot" style="color:#fff;font-size:.72rem;"></i>
                </div>
                <span style="color:rgba(255,255,255,.4);font-size:.7rem;font-weight:700;">AI Business Advisor</span>
            </div>
            <div style="color:rgba(255,255,255,.75);font-size:.83rem;line-height:1.75;">${response}</div>`;
        userBubble.scrollIntoView({behavior:'smooth', block:'end'});
    }, 900 + Math.random()*400);
}

function generateAdvisorResponse(q, d) {
    const topProds   = [...d.products].sort((a,b)=>b.qty30-a.qty30).slice(0,3).filter(p=>p.qty30>0);
    const lowProds   = d.products.filter(p=>p.qty30===0&&p.stock>0);
    const hiMargin   = [...d.products].filter(p=>p.margin>=25).sort((a,b)=>b.margin-a.margin).slice(0,4);
    const lossProds  = d.products.filter(p=>p.cost>p.retail&&p.retail>0);
    const deadStock  = d.products.filter(p=>p.qty30===0&&p.stock>10);
    const lowMargin  = d.products.filter(p=>p.margin<12&&p.margin>0);
    const highProfit = [...d.products].sort((a,b)=>b.profit30-a.profit30).slice(0,3).filter(p=>p.profit30>0);

    // ── PROFIT IMPROVEMENT ──
    if (q.includes('profit') || q.includes('increase') || q.includes('improve')) {
        const tips = [];
        if (hiMargin.length)
            tips.push(`<b>Focus on high-margin products:</b> ${hiMargin.map(p=>`${p.name} (${p.margin}%)`).join(', ')} — put more energy into selling these`);
        if (deadStock.length)
            tips.push(`<b>Clear dead stock:</b> ${deadStock.map(p=>p.name).join(', ')} — no sales in 30 days. Offer 10–15% discount to free up capital`);
        if (lossProds.length)
            tips.push(`<b>Fix loss-making products immediately:</b> ${lossProds.map(p=>p.name).join(', ')} — these are being sold below cost!`);
        if (d.margin30 < 20)
            tips.push(`<b>Overall margin is only ${d.margin30}%</b> — target 25%+. Raise prices on slow-moving products to improve margins`);
        if (d.exp30 > 0)
            tips.push(`<b>Control expenses:</b> Rs.${d.exp30.toLocaleString()}/month — a 10% reduction saves Rs.${Math.round(d.exp30*0.1).toLocaleString()} monthly`);
        if (lowMargin.length)
            tips.push(`<b>${lowMargin.length} products have margin below 12%</b> — check the Smart Price tab for recommended prices`);
        return tips.length
            ? `💰 <b>Steps to increase profit:</b><br><br>✅ ` + tips.join('<br><br>✅ ')
            : `✅ Your business looks healthy! Maintain consistent sales and keep focusing on high-margin products.`;
    }

    // ── STOCK RECOMMENDATIONS ──
    if (q.includes('stock') || q.includes('order') || q.includes('purchase') || q.includes('reorder') || q.includes('which')) {
        if (!topProds.length) return '📦 No sales data yet. Record some sales first so AI can give you stock recommendations.';
        return `📦 <b>Always keep these products in stock:</b><br><br>` +
            topProds.map(p=>`• <b>${p.name}</b> — ${p.qty30} sold/30d, ${fmtRs(p.profit30)} profit/month`).join('<br>') +
            (deadStock.length ? `<br><br>❌ <b>Do NOT restock these products:</b><br>${deadStock.slice(0,3).map(p=>`• ${p.name} (0 sales/30d)`).join('<br>')}` : '') +
            '<br><br>💡 Rule: For best-selling products, always maintain at least 30 days supply in stock.';
    }

    // ── SLOW BUSINESS ──
    if (q.includes('slow') || q.includes('business') || q.includes('sales down') || q.includes('why')) {
        const reasons = [];
        if (deadStock.length) reasons.push(`${deadStock.length} products have dead stock — capital is blocked (Rs.${d.products.filter(p=>p.qty30===0&&p.stock>10).reduce((acc,p)=>acc+p.stock*p.cost,0).toLocaleString()})`);
        if (d.margin30 < 15)  reasons.push(`Overall profit margin is only ${d.margin30}% — there may be a pricing issue`);
        if (lossProds.length) reasons.push(`${lossProds.length} products are being sold at a loss!`);
        if (!topProds.length) reasons.push('No sales data yet — record more transactions to get AI analysis');
        reasons.push('Increase visibility of top products — feature them on your POS screen');
        reasons.push('Collect customer feedback — find out what they are looking for');
        return `🔍 <b>Possible reasons your sales are slow:</b><br><br>• ` + reasons.join('<br>• ');
    }

    // ── BEST SELLERS ──
    if (q.includes('best') || q.includes('top') || q.includes('popular') || q.includes('selling')) {
        if (!topProds.length) return '🏆 Not enough sales data yet. More transactions will reveal detailed rankings.';
        return `🏆 <b>Top performing products (last 30 days):</b><br><br>` +
            topProds.map((p,i)=>`${['🥇','🥈','🥉'][i]} <b>${p.name}</b> — ${p.qty30} units sold, ${fmtRs(p.profit30)} profit, ${p.margin}% margin`).join('<br>') +
            '<br><br>💡 Focus on these products — always keep them in stock and display them prominently!';
    }

    // ── DISCONTINUE ──
    if (q.includes('discontinue') || q.includes('remove') || q.includes('stop') || q.includes('drop')) {
        const poorPerf = d.products.filter(p=>p.qty30===0&&p.stock>0).slice(0,5);
        if (!poorPerf.length) return '✅ No clearly poor products found. More sales data will enable better recommendations.';
        return `❌ <b>Consider discontinuing these products:</b><br><br>` +
            poorPerf.map(p=>`• <b>${p.name}</b> — zero sales in 30 days, ${p.margin}% margin, ${p.stock} units in stock`).join('<br>') +
            '<br><br>💡 Strategy: First apply a 15–20% discount to clear remaining stock, then discontinue. This frees up capital for better-performing products.';
    }

    // ── WEEKLY STRATEGY ──
    if (q.includes('strategy') || q.includes('plan') || q.includes('weekly') || q.includes('week')) {
        return `🎯 <b>Your Strategy for Next Week:</b><br><br>` +
            (topProds.length ? `1. <b>Ensure top products are restocked:</b> ${topProds.map(p=>p.name).join(', ')}<br>` : '') +
            (deadStock.length ? `2. <b>Run a discount sale on dead stock:</b> ${deadStock.slice(0,2).map(p=>p.name).join(', ')} — offer 15% off<br>` : '') +
            `3. <b>Set a daily sales target</b> — track progress in the Analytics tab<br>` +
            `4. <b>Improve your margin</b> — currently ${d.margin30}%, target 25%+ (use the Smart Price tab)<br>` +
            (lossProds.length ? `5. <b>Fix loss-making product prices:</b> ${lossProds.map(p=>p.name).join(', ')}` :
             hiMargin.length  ? `5. <b>Promote high-margin products:</b> ${hiMargin[0]?.name} (${hiMargin[0]?.margin}% margin)` :
                                `5. <b>Explore new high-margin products</b> to expand your range`);
    }

    // ── EXPENSES ──
    if (q.includes('expense') || q.includes('reduce') || q.includes('cost') || q.includes('saving')) {
        return `✂️ <b>Ways to Reduce Expenses:</b><br><br>` +
            `• Current monthly expenses: Rs.${d.exp30.toLocaleString()}<br>` +
            `• Expenses are ${d.rev30>0?((d.exp30/d.rev30)*100).toFixed(1):0}% of revenue (target: below 15%)<br><br>` +
            `💡 <b>Action Tips:</b><br>` +
            `• Negotiate bulk discounts with your suppliers<br>` +
            `• Check for electricity and utility wastage<br>` +
            `• Liquidate dead stock — this saves storage costs and frees up capital<br>` +
            `• Focus on fewer, high-performing products — reducing variety can lower overhead`;
    }

    // ── MOST PROFITABLE ──
    if (q.includes('most profitable') || q.includes('profitable') || q.includes('profit')) {
        if (!highProfit.length) return '💎 Limited profit data available. More sales will reveal detailed profitability rankings.';
        return `💎 <b>Your most profitable products:</b><br><br>` +
            highProfit.map((p,i)=>`${['🥇','🥈','🥉'][i]} <b>${p.name}</b> — ${fmtRs(p.profit30)}/month, ${p.margin}% margin`).join('<br>') +
            '<br><br>💡 Always maintain stock for these products — they are your primary income source!';
    }

    // ── DEFAULT ──
    return `🤖 <b>Your Business Summary:</b><br><br>` +
        `• Monthly Revenue: ${fmtRs(d.rev30)}<br>` +
        `• Monthly Profit: ${fmtRs(d.prof30)} (${d.margin30}% margin)<br>` +
        `• Total Transactions: ${d.txn30}<br>` +
        `• Total Products: ${d.products.length}<br>` +
        (topProds.length ? `• Best Seller: ${topProds[0].name} (${topProds[0].qty30} sold/month)<br>` : '') +
        (deadStock.length ? `• Dead Stock: ${deadStock.length} products need attention<br>` : '') +
        `<br>Ask me anything — about profit, stock, pricing, or business strategy!`;
}

function fmtRs(v) {
    v = parseFloat(v)||0;
    if (v>=100000) return 'Rs.'+(v/100000).toFixed(1)+'L';
    if (v>=1000)   return 'Rs.'+(v/1000).toFixed(1)+'K';
    return 'Rs.'+Math.round(v);
}


// ═══════════════════════════════════════════════════════════════
//  TAB 6 — AUTO TAGS FILTER
// ═══════════════════════════════════════════════════════════════
function filterTag(tag, clickedEl) {
    // Update card highlight
    document.querySelectorAll('.tag-filter-card').forEach(c => {
        c.style.outline = 'none';
        c.style.boxShadow = 'none';
    });
    if (clickedEl) {
        clickedEl.style.outline = '2px solid rgba(108,99,255,.55)';
        clickedEl.style.boxShadow = '0 0 0 4px rgba(108,99,255,.12)';
    }

    // Filter products
    let shown = 0;
    document.querySelectorAll('.tag-prod-item').forEach(el => {
        const tags = el.dataset.tags || '';
        const vis  = tag==='all' || tags.includes(tag);
        el.style.display = vis ? '' : 'none';
        if (vis) shown++;
    });

    // Active label
    const lbl = document.getElementById('tagActiveLabel');
    const nm  = document.getElementById('tagActiveName');
    if (tag === 'all') {
        lbl.style.display = 'none';
    } else {
        lbl.style.display = '';
        nm.textContent = `${tag} (${shown} products)`;
    }
}
</script>

<?php shopFooter(); ?>
